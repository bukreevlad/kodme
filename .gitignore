# ===========================================================================
# .gitignore — репозиторий дистрибутива Kodme
#
# Runtime-данные, логи и материалы выпуска создаются при работе стенда —
# в git они не коммитятся (ни сюда, ни в форки).
# ===========================================================================

# Логи приложения и nginx
kodme/logs/
kodme/media-worker/
nginx/logs/
*.log

# Данные контейнеров
redis/data/
seaweedfs/data/

# Бэкапы PostgreSQL
postgres/backup/
*.dump

# Сертификаты TLS (материалы выпуска — только на вашем сервере)
nginx/ssl/

# ОС и редакторы
.DS_Store
Thumbs.db
*.swp
.idea/
